{
  "compilerOptions": {
    "target": "ES2020",
    "resolveJsonModule": true,
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "eslint.config.js", "src/content/**/*.ts", "src/content/**/*.json"],
  "exclude": ["src/**/*.test.ts"]
}
